# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# The protocol page is generated from src/content/method.ts by
# `npm run build:protocol`, which the build and the dev server both run. It sits at
# the repository root rather than somewhere tidier because Vite names an HTML output
# after its path relative to the root, and dist/protocol.html is the URL that has to
# exist. It is build output like anything in dist/ and is not committed: hard rule 1
# forbids a file that a tool produces and a hand then edits. Edit the content module.
/protocol.html

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Local environment overrides.
# .env is committed on purpose: it holds VITE_REFLECT_ENDPOINT, and whether the
# live-Claude endpoint is connected should be answerable by reading the repo.
.env.local
.env.*.local

# Serverless / edge tooling
.wrangler/
.vercel/

# The Worker's local secrets, which hold the API key when running the endpoint
# on a development machine. .env is committed on purpose; this never is.
.dev.vars

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.TemporaryItems
.apdisk
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Desktop.ini

# Linux
.directory
