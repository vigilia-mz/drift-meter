{
  "name": "drift-meter",
  "version": "0.8.0",
  "private": true,
  "description": "The Drift Meter — Experiment 01 of the Agential Drift Research Program",
  "license": "Apache-2.0",
  "author": "Megi Pishtari",
  "homepage": "https://vigilia-mz.github.io/drift-meter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigilia-mz/drift-meter.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:protocol && vite",
    "build": "npm run typecheck && npm run build:protocol && vite build",
    "build:protocol": "node scripts/build-protocol.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:size": "node scripts/check-size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:licensing": "node scripts/check-licensing.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:contrast && npm run check:licensing && npm run build:protocol",
    "counts": "node scripts/counts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
